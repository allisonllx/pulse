# Copy to .env.local. Never commit credentials or local evidence.
OXYLABS_USERNAME=
OXYLABS_PASSWORD=
# Residential proxy gateway. Country/session are encoded in the username.
OXYLABS_PROXY_HOST=pr.oxylabs.io
OXYLABS_PROXY_PORT=7777
# Required explicit total traffic cap; 20% is reserved and never scheduled.
WORLDVIEW_BUDGET_BYTES=0
WORLDVIEW_DATA_DIR=.worldview
# Set your actual expiry, with timezone, e.g. YYYY-MM-DDTHH:MM:SS+08:00.
# Leave empty only while testing; the bounded worker stops after 44 windows regardless.
WORLDVIEW_EXPIRES_AT=
WORLDVIEW_HOST_DELAY_SECONDS=2
